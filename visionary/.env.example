# Copy to .env.local and fill in. Never commit .env.local.

# Public site URL (no trailing slash) for canonical links, sitemap and social previews, e.g. https://www.example.my
NEXT_PUBLIC_SITE_URL=

# Set to true on preview/review deploys (e.g. the Netlify link for the client) so search engines don't index them.
# Leave unset on the real production site.
SITE_NOINDEX=

# Data source for reviews/enquiries AND admin login: "mock" (in-memory demo data, demo login) or "supabase"
DATA_SOURCE=mock

# Mock admin login (frontend phase only; replaced by Supabase Auth in Phase B).
# In development, if unset, the demo login is owner@visionary.local / visionary-demo.
# In production these MUST be set or admin login is disabled.
ADMIN_DEMO_EMAIL=
ADMIN_DEMO_PASSWORD=
# Long random string used to sign the admin session cookie (e.g. `openssl rand -base64 32`)
SESSION_SECRET=

# Dev only: extra hosts allowed to call Server Actions (comma-separated),
# for browsing through a preview/tunnel proxy instead of localhost:3000.
# The preview tool uses a random port each session, e.g.: 127.0.0.1:52208
# ALLOWED_ACTION_ORIGINS=

# Supabase (Project Settings → API). URL + anon key are public; the service-role key is SECRET (server only,
# bypasses Row Level Security): never commit it, never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
